{
  "expo": {
    "name": "Dhillon Dhaba",
    "slug": "dhillon-dhaba-mobile",
    "scheme": "dhillondhaba",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dhillondhaba.app"
    },
    "android": {
      "package": "com.dhillondhaba.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF8E1"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
